# Tool versions that more than one script uses, pinned once. Scripts source this file; tests read it, check
# that nothing else writes these versions, and that what can't source it matches (tests/test_versions.py).

# The Kubernetes version of k3s on the AWS node (ansible/roles/k3s/defaults/main.yml). kubeconform validates
# the manifests against it (ci/k8s-checks.sh), and Helm renders the add-on charts for it (scripts/addon.sh).
KUBERNETES_VERSION=1.36.6

# Trivy, as a Docker image in ci/scan.sh and ci/terraform-checks.sh. CI's trivy-action installs the same
# version (.github/workflows/ci.yml).
TRIVY_VERSION=0.75.0

# restic: the homelab backup's image (backup/cronjob.yaml) and the AWS node's binary
# (ansible/roles/restic_backup). Neither can source this file; tests/test_restic_backup.py checks both copies.
RESTIC_VERSION=0.19.1
