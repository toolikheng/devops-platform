# External Secrets Operator's Helm chart. scripts/install-eso.sh installs it and scripts/render-eso.sh renders
# it for the checks, both from this file, so the checks always see the version the cluster gets.
# 2.15.0: released 2026-11-10 (latest on 2026-11-22).
ESO_CHART=external-secrets
ESO_CHART_REPO=https://charts.external-secrets.io
ESO_CHART_VERSION=2.15.0
