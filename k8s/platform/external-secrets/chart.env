# External Secrets Operator's Helm chart. scripts/addon.sh installs it and renders it for the checks, both from
# this file, so the checks always see the version the cluster gets. It runs on the AWS node only
# (values-aws.yaml): k3d has no AWS identity.
# 2.15.0: released 2026-11-10 (latest on 2026-11-22).
CHART=external-secrets
CHART_REPO=https://charts.external-secrets.io
CHART_VERSION=2.15.0
NAMESPACE=external-secrets
# Applied after the chart: the store's CRD and the webhook that validates it come from the chart.
MANIFESTS=clustersecretstore.yaml
