# kube-prometheus-stack: Prometheus, Alertmanager, Grafana, kube-state-metrics and the Prometheus operator.
# scripts/addon.sh installs it and renders it for the checks, both from this file. Runs on the local k3d
# cluster (values-local.yaml, make monitoring-up).
# Helm installs the chart's CRDs on the first install but never upgrades them, so bump this deliberately and
# follow the chart's upgrade notes. ci/rules-test.sh tests the alert rules with the Prometheus it runs.
CHART=kube-prometheus-stack
CHART_REPO=https://prometheus-community.github.io/helm-charts
CHART_VERSION=92.16.0
NAMESPACE=monitoring
