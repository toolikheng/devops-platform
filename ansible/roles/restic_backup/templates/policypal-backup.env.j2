# Settings of /usr/local/sbin/policypal-backup, read by policypal-backup.service (EnvironmentFile) and by a
# backup or restore run by hand. No secret: restic gets the repository password by running RESTIC_PASSWORD_COMMAND,
# which reads it from SSM Parameter Store with the node's role.
RESTIC_REPOSITORY=s3:s3.{{ restic_backup_region }}.amazonaws.com/{{ restic_backup_bucket }}/restic
RESTIC_PASSWORD_COMMAND="/usr/local/sbin/ssm-parameter {{ restic_backup_password_parameter }}"
AWS_DEFAULT_REGION={{ restic_backup_region }}
# One host name for every node, so the snapshots of rebuilt nodes form one group for retention.
RESTIC_HOST=policypal
RESTIC_CACHE_DIR=/var/cache/restic
# k3s's own admin kubeconfig, readable by root only.
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# node_exporter's textfile collector: a successful backup writes the time here.
BACKUP_TEXTFILE_DIR={{ restic_backup_textfile_dir }}
