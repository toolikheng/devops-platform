# Backs PolicyPal up to S3 with restic (files/policypal-backup.sh). Started every hour by policypal-backup.timer,
# or by hand: systemctl start policypal-backup. A failed run leaves the unit failed: systemctl status policypal-backup.
[Unit]
Description=Back up PolicyPal (Postgres dump and uploads) to S3 with restic
After=k3s.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/policypal-backup
# The repository, and how restic gets its password: from SSM Parameter Store at run time, never a value here.
Environment=RESTIC_REPOSITORY=s3:s3.{{ restic_backup_region }}.amazonaws.com/{{ restic_backup_bucket }}/restic
Environment=RESTIC_PASSWORD_COMMAND=/usr/local/sbin/ssm-parameter {{ restic_backup_password_parameter }}
Environment=AWS_DEFAULT_REGION={{ restic_backup_region }}
# One host name for every node, so the snapshots of rebuilt nodes form one group for retention.
Environment=RESTIC_HOST=policypal
Environment=RESTIC_CACHE_DIR=/var/cache/restic
# k3s's own admin kubeconfig, readable by root only.
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
