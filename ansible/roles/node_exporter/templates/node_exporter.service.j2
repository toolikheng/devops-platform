# Managed by Ansible (role node_exporter)
{% set args = node_exporter_args + (['--collector.textfile.directory=' ~ node_exporter_textfile_dir] if node_exporter_textfile_dir else []) %}
[Unit]
Description=Prometheus Node Exporter
Documentation=https://github.com/prometheus/node_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ node_exporter_user }}
Group={{ node_exporter_user }}
ExecStart=/usr/local/bin/node_exporter{% for arg in args %} \
  {{ arg | replace('$', '$$') }}{% endfor %}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
