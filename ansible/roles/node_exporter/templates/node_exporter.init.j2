#!/bin/sh
### BEGIN INIT INFO
# Provides:          node_exporter
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Prometheus Node Exporter
### END INIT INFO
# Managed by Ansible (role node_exporter). Used on hosts without systemd, such as the Docker nodes.

DAEMON=/usr/local/bin/node_exporter
PIDFILE=/run/node_exporter.pid
LOGFILE=/var/log/node_exporter.log
USER={{ node_exporter_user }}

start() {
  start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid "$USER" --output "$LOGFILE" --exec "$DAEMON" -- \
{% for arg in node_exporter_args %}
    '{{ arg }}'{% if not loop.last %} \{% endif %}

{% endfor %}
}

stop() {
  start-stop-daemon --stop --quiet --oknodo --retry TERM/10/KILL/5 --pidfile "$PIDFILE" --remove-pidfile
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status) start-stop-daemon --status --pidfile "$PIDFILE" ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
